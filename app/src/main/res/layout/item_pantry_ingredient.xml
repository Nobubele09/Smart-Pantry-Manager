<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/pantry_card_background">

    <TextView
        android:id="@+id/txtIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rice"
        android:textColor="#183D2B"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtIngredientQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Quantity: 2 cups"
        android:textColor="#444444"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txtIngredientExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Fresh"
        android:textColor="#245C43"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditIngredient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Edit"
            android:textColor="#FFFFFF"
            android:backgroundTint="#245C43" />

        <Button
            android:id="@+id/btnDeleteIngredient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Delete"
            android:textColor="#FFFFFF"
            android:backgroundTint="#BE4137" />

    </LinearLayout>

</LinearLayout>

